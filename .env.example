# ─── Banco (Turso em produção / SQLite local em dev) ───
# Local: deixe TURSO_* vazio — usa file:dev.db automaticamente
# Produção (Vercel): preencha com os dados do painel Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Firebase Authentication (Google)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_ADMIN_EMAILS=
# Somente local: caminho do JSON da conta de serviÃ§o baixado no Firebase.
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional: protege POST /api/auth/setup em produção (header X-Setup-Secret)
SETUP_SECRET=

# Next.js (Vercel define NODE_ENV=production automaticamente)
# NODE_ENV=development
