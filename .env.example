# ─── Banco (Turso em produção / SQLite local em dev) ───
# Local: deixe TURSO_* vazio — usa file:dev.db automaticamente
# Produção (Vercel): preencha com os dados do painel Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: protege POST /api/auth/setup em produção (header X-Setup-Secret)
SETUP_SECRET=

# Next.js (Vercel define NODE_ENV=production automaticamente)
# NODE_ENV=development
